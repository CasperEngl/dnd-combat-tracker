{
  "name": "@dnd-combat-tracker/workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run lint && bun run typecheck && bun run test",
    "codegen": "bun run convex:codegen && bun ./packages/convex-hook-api/src/cli.ts generate --functions-dir packages/convex/functions --out packages/convex/client/hook-api.tsx",
    "convex:codegen": "convex codegen",
    "dev": "convex dev --run-sh \"bun --cwd apps/web run dev:plain\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "react-compiler:check": "bun ./packages/react-compiler-check/src/cli.ts apps/web/src",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "convex": "^1.32.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
