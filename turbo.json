{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": ["build/**", "dist/**"]
    },
    "codegen": {
      "outputs": ["_generated/**", "client/hook-api.tsx"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typegen": {
      "outputs": [".react-router/types/**"]
    }
  }
}
